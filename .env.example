# Copy to .env and fill in before running forms against real services.
# Nothing in this file is a real credential.

# Supabase (form submission log the office can view/print)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email notification on every form submission)
RESEND_API_KEY=
FORM_NOTIFICATION_TO=office@theplainoffice.com
FORM_NOTIFICATION_FROM=forms@theplainoffice.com

# Simple in-memory/edge rate limiting window (seconds) and max submissions per window per IP
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_SUBMISSIONS=5
