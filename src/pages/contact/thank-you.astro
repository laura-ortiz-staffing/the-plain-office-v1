---
// This third thank-you page isn't listed in Build Brief v2 §4 (which
// names only two), but its full copy appears in both the Specification
// and the Copy Deck (and now the Figma), and the Key Findings memo
// flags the same gap. Built on the assumption it's in scope.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { contact } from '../../data/copy/contact';
import { site } from '../../data/site';
---

<BaseLayout title={`${contact.thankYou.heading} — The Plain Office`} description={contact.thankYou.body} path="/contact/thank-you">
  <section class="section" style="background:var(--color-cream-2);">
    <div class="wrap two-col" style="grid-template-columns: 1fr 1.3fr;">
      <div>
        <h3 style="border-bottom:1px solid var(--color-rule-2); padding-bottom:12px;">{contact.routesHeading}</h3>
        <ul class="routes-list">
          <li>
            <Icon name="mail" size={22} />
            <div><h3>Write</h3><p>{site.name}<br />{site.mailingAddressLine1}<br />{site.mailingAddressLine2}</p></div>
          </li>
          <li>
            <Icon name="phone" size={22} />
            <div><h3>Telephone</h3><p>Direct: <a href={site.phoneHref}>{site.phoneDisplay}</a><br />{site.businessHoursNote}</p></div>
          </li>
          <li>
            <Icon name="fax" size={22} />
            <div><h3>Facsimile</h3><p>{site.faxDisplay}</p></div>
          </li>
          <li>
            <Icon name="at" size={22} />
            <div><h3>Electronic Mail</h3><p><a href={`mailto:${site.email}`}>{site.email}</a></p></div>
          </li>
        </ul>
        <div class="photo-frame" style="padding:0;">
          <div class="photo-placeholder" style="min-height:200px;">Photo — placeholder</div>
        </div>
      </div>

      <div class="form-card thank-you-center">
        <Icon name="envelope-check" size={40} />
        <h2 class="no-rule">{contact.thankYou.heading}</h2>
        <p style="color:var(--color-ink-secondary);">{contact.thankYou.body}</p>
        <a href="/" style="color:var(--color-bronze); font-weight:700; letter-spacing:.06em; text-transform:uppercase; font-size:13px; text-decoration:underline;">
          {contact.thankYou.returnLinkLabel}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
