---
import BaseLayout from '../layouts/BaseLayout.astro';
import PullQuote from '../components/PullQuote.astro';
import BookletForm from '../components/forms/BookletForm.astro';
import { booklet } from '../data/copy/booklet';

const title = `${booklet.headline} — The Plain Office`;
---

<BaseLayout title={title} description={booklet.intro} path="/booklet">
  <section class="section">
    <div class="wrap" style="display:grid; grid-template-columns: 1fr 1.4fr; gap:40px; align-items:start;">
      <div class="card" style="text-align:center;">
        <p class="small-note" style="text-transform:uppercase; letter-spacing:.1em;">{booklet.coverCard.brandLine}</p>
        <h3 style="margin:12px 0;">{booklet.coverCard.title}</h3>
        <p class="small-note">{booklet.coverCard.subtitle}</p>
        <p class="kicker" style="margin-top:16px;">{booklet.coverCard.kicker}</p>
      </div>
      <div>
        <p class="kicker">{booklet.kicker}</p>
        <h1>{booklet.headline}</h1>
        <p class="lede">{booklet.intro}</p>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--color-cream);">
    <div class="wrap prose">
      <h2>{booklet.contents.heading}</h2>
      <ol style="color:var(--color-ink-secondary);">
        {booklet.contents.chapters.map((ch) => <li style="margin-bottom:6px;">{ch}</li>)}
      </ol>
      <PullQuote caption={booklet.excerpt.caption}>{booklet.excerpt.quote}</PullQuote>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <BookletForm />
    </div>
  </section>
</BaseLayout>
