---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookletForm from '../components/forms/BookletForm.astro';
import { booklet } from '../data/copy/booklet';

const title = `${booklet.headline} — The Plain Office`;
---

<BaseLayout title={title} description={booklet.intro} path="/booklet">
  <section class="section" style="background:var(--color-cream-2);">
    <div class="wrap two-col">
      <div>
        <p class="kicker">{booklet.kicker}</p>
        <h1>{booklet.headline}</h1>
        <p style="color:var(--color-ink-secondary);">{booklet.intro}</p>
        <div style="width:48px; border-top:3px solid var(--color-bronze); margin-top:20px;"></div>
      </div>
      <div class="booklet-cover-mock">
        <p class="edition">{booklet.coverMock.edition}</p>
        <h2>{booklet.coverMock.title}</h2>
        <div class="rule"></div>
        <p class="volume">{booklet.coverMock.volume}</p>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--color-cream-2);">
    <div class="wrap two-col">
      <div>
        <h2 class="no-rule">{booklet.contents.heading}</h2>
        <ul class="toc-list">
          {booklet.contents.chapters.map((ch, i) => (
            <li>
              <span class="toc-title">{i + 1}. {ch.title}</span>
              <span class="toc-fill"></span>
              <span class="toc-page">{ch.page}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="notice" style="max-width:none;">
        <p style="margin:0 0 10px;">{booklet.excerpt.quote}</p>
        <p style="margin:0; font-weight:700; font-style:normal; text-transform:uppercase; font-size:12px; letter-spacing:.06em;">— {booklet.excerpt.caption}</p>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--color-cream-2); text-align:center;">
    <div class="wrap">
      <h2 class="no-rule">{booklet.form.heading}</h2>
      <p class="small-note" style="margin-bottom:32px;">{booklet.form.subtext}</p>
      <div style="text-align:left; max-width:640px; margin:0 auto;">
        <BookletForm />
      </div>
    </div>
  </section>
</BaseLayout>
