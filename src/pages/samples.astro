---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoticeBox from '../components/NoticeBox.astro';
import SampleReportGallery from '../components/SampleReportGallery.astro';
import { samples } from '../data/copy/samples';

const title = `${samples.headline} — The Plain Office`;
---

<BaseLayout title={title} description={samples.intro} path="/samples">
  <section class="section">
    <div class="wrap">
      <p class="kicker">{samples.kicker}</p>
      <h1>{samples.headline}</h1>
      <p class="lede">{samples.intro}</p>
      <p class="small-note" style="font-style:italic; margin-top:10px;">{samples.verse}</p>
      <div style="margin-top:20px;">
        <NoticeBox>{samples.disclaimer}</NoticeBox>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--color-cream);">
    <div class="wrap">
      <SampleReportGallery />
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>{samples.fitted.heading}</h2>
      {samples.fitted.paragraphs.map((p) => <p>{p}</p>)}
      <a class="btn btn-primary" href={samples.fitted.button.href}>{samples.fitted.button.label}</a>
    </div>
  </section>
</BaseLayout>
