---
import BaseLayout from '../layouts/BaseLayout.astro';
import { samples } from '../data/copy/samples';

const title = `${samples.headline} — The Plain Office`;
const description = samples.overview.paragraph;
---

<BaseLayout title={title} description={description} path="/samples">
  <section class="section" style="background:var(--color-white); text-align:center;">
    <div class="wrap">
      <p class="kicker">{samples.kicker}</p>
      <h1>{samples.headline}</h1>
      <div class="notice" style="max-width:44em; margin:24px auto 0; text-align:left;">{samples.verse}</div>
    </div>
  </section>

  <section class="section" style="background:var(--color-white);">
    <div class="wrap">
      <div class="overview-box">
        <div class="two-col">
          <div>
            <h2 class="no-rule">{samples.overview.heading}</h2>
            <p style="color:var(--color-ink-secondary);">{samples.overview.paragraph}</p>
          </div>
          <div>
            <p class="eyebrow">{samples.overview.pillarsEyebrow}</p>
            <p style="font-style:italic; color:var(--color-ink-secondary);">{samples.overview.pillarsIntro}</p>
          </div>
        </div>
        <div class="pillars-grid">
          {samples.overview.pillars.map((p) => (
            <div>
              <h4>{p.title}</h4>
              <p>{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--color-white); text-align:center;">
    <div class="wrap">
      <h2 class="no-rule">{samples.galleryHeading}</h2>
      <div class="card-grid" style="grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); margin-top:32px;">
        {samples.gallery.map((item) => (
          <div class="gallery-card">
            <div class="photo-placeholder">Photo — placeholder</div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
      <a class="btn btn-primary" href={samples.cta.href} style="margin-top:36px; display:inline-flex;">{samples.cta.label}</a>
    </div>
  </section>
</BaseLayout>
