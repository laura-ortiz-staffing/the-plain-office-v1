---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/copy/services';

const title = `${services.headline} — The Plain Office`;
---

<BaseLayout title={title} description={services.intro} path="/services">
  <section class="section" style="background:var(--color-cream-2); text-align:center;">
    <div class="wrap">
      <h1>{services.headline}</h1>
      <p class="lede" style="margin:0 auto; text-align:center;">{services.intro}</p>
    </div>
  </section>

  <section class="section" style="background:var(--color-cream-2);">
    <div class="wrap">
      <div class="photo-frame">
        <div class="photo-placeholder">
          <!-- Placeholder: no photo of a ledger/desk scene was supplied. -->
          Photo — placeholder
        </div>
      </div>

      <div class="notice" style="margin-top:32px; max-width:none;">
        <h3 style="margin:0 0 6px; color:var(--color-navy);">{services.privacyPromise.heading}</h3>
        <p style="margin:0; font-style:italic;">{services.privacyPromise.body}</p>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--color-cream-2); text-align:center;">
    <div class="wrap">
      <h2 class="no-rule" style="border-bottom:1px solid var(--color-rule-2); padding-bottom:28px;">{services.conventions.heading}</h2>
      <div class="conventions-row" style="margin-top:32px;">
        {services.conventions.items.map((item, i) => (
          <div class={i > 0 ? 'conventions-row-item' : ''}>
            <Icon name={item.icon as any} />
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--color-cream-2);">
    <div class="wrap">
      <hr class="divider-line" style="margin-bottom:40px;" />
      <div class="two-col">
        <div>
          <h3>{services.honestFit.heading}</h3>
          <p style="color:var(--color-ink-secondary); margin:0;">{services.honestFit.body}</p>
        </div>
        <div class="verdict-box">
          <p class="kicker">{services.verdict.kicker}</p>
          <p class="quote">{services.verdict.quote}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
