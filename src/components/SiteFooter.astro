---
// Dark navy, text-only footer matching the approved Figma screens
// (2026-07-30) — drops the phone/address/verse the old footer showed
// directly, since the header now carries the phone on every page and
// full contact details live on /contact. See CHANGELOG.md.
import { site } from '../data/site';

interface Props {
  currentPath?: string;
}
const { currentPath } = Astro.props;
---

<footer class="site-foot-dark">
  <div class="wrap">
    <p class="foot-brand">{site.name.toUpperCase()}</p>
    <ul class="foot-links-dark">
      {site.footerLinks.map((item) => (
        <li><a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
    <p class="foot-copyright">&copy; 2026 {site.name.toUpperCase()}. {site.tagline}</p>
  </div>
</footer>
