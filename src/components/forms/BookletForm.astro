---
import { booklet } from '../../data/copy/booklet';

const errorField = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  name: 'We need your name to send the booklet.',
  street_address: 'We need your mailing address to send the booklet.',
  rate_limited: 'That is a lot of requests in a short time — please try again in a minute.',
};
const errorMessage = errorField ? errorMessages[errorField] : null;
---

<form class="tpo-form form-card" method="post" action="/api/booklet" novalidate>
  {errorMessage && <p class="field-error" role="alert">{errorMessage}</p>}

  <div class="honeypot-field" aria-hidden="true">
    <label for="booklet-website">Leave this field blank</label>
    <input id="booklet-website" type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field">
    <label id="delivery-label">{booklet.form.formatLabel}</label>
    <div class="inline-radio-group" role="radiogroup" aria-labelledby="delivery-label">
      {booklet.form.deliveryChoices.map((choice, i) => (
        <div class="choice-option">
          <input type="radio" id={`delivery-${choice.value}`} name="delivery" value={choice.value} checked={i === 0} />
          <label for={`delivery-${choice.value}`} style="margin:0; font-weight:400;">{choice.label}</label>
        </div>
      ))}
    </div>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="booklet-name">Full Name</label>
      <input id="booklet-name" type="text" name="name" class={errorField === 'name' ? 'field-missing' : ''} />
    </div>
    <div class="field">
      <label for="booklet-org">Organization <span class="hint">Optional</span></label>
      <input id="booklet-org" type="text" name="organization" />
    </div>
  </div>

  <div class="field">
    <!-- Client confirmed 2026-07-31: email must never be required. -->
    <label for="booklet-email">Email Address <span class="hint">Optional</span></label>
    <input id="booklet-email" type="email" name="email" />
  </div>

  <div class="field">
    <label>Mailing Address *</label>
    <input type="text" name="street_address" placeholder="Street Address" style="margin-bottom:12px;" class={errorField === 'street_address' ? 'field-missing' : ''} aria-label="Street Address" />
    <div class="field-row">
      <input type="text" name="city" placeholder="City" aria-label="City" />
      <input type="text" name="postal_code" placeholder="Postal Code" aria-label="Postal Code" />
    </div>
  </div>

  <div class="form-actions-center">
    <button class="btn btn-primary" type="submit">{booklet.form.submitLabel}</button>
  </div>
</form>
