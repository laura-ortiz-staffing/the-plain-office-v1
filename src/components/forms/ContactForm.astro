---
import { contact } from '../../data/copy/contact';

const errorField = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  name: 'We need your name.',
  message: 'We need a message so we know what to answer.',
  rate_limited: 'That is a lot of requests in a short time — please try again in a minute.',
};
const errorMessage = errorField ? errorMessages[errorField] : null;
---

<form class="tpo-form" method="post" action="/api/contact" novalidate>
  {errorMessage && <p class="field-error" role="alert">{errorMessage}</p>}

  <div class="honeypot-field" aria-hidden="true">
    <label for="contact-website">Leave this field blank</label>
    <input id="contact-website" type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field-row">
    <div class="field">
      <label for="contact-name">{contact.form.nameLabel}</label>
      <input id="contact-name" type="text" name="name" placeholder={contact.form.namePlaceholder} class={errorField === 'name' ? 'field-missing' : ''} />
    </div>
    <div class="field">
      <label for="contact-business">{contact.form.businessLabel}</label>
      <input id="contact-business" type="text" name="business_and_trade" placeholder={contact.form.businessPlaceholder} />
    </div>
  </div>

  <div class="field-row">
    <div class="field">
      <label for="contact-reach">{contact.form.reachMethodLabel}</label>
      <select id="contact-reach" name="reach_method">
        {contact.form.reachMethodChoices.map((choice) => <option value={choice}>{choice}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="contact-identifier">{contact.form.identifierLabel}</label>
      <input id="contact-identifier" type="text" name="contact_identifier" placeholder={contact.form.identifierPlaceholder} />
    </div>
  </div>

  <div class="field">
    <label for="contact-message">{contact.form.messageLabel}</label>
    <textarea id="contact-message" name="message" placeholder={contact.form.messagePlaceholder} class={errorField === 'message' ? 'field-missing' : ''}></textarea>
  </div>

  <div class="form-actions-center">
    <button class="btn btn-primary" type="submit">{contact.form.submitLabel}</button>
  </div>
</form>
