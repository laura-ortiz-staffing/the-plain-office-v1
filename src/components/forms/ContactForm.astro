---
import { contact } from '../../data/copy/contact';

const errorField = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  name: 'We need your name.',
  message: 'We need a message so we know what to answer.',
  reach: 'We need at least one way to reach you — telephone, address, or email.',
  rate_limited: 'That is a lot of requests in a short time — please try again in a minute.',
};
const errorMessage = errorField ? errorMessages[errorField] : null;
---

<form class="tpo-form" method="post" action="/api/contact" novalidate>
  <h3>{contact.form.heading}</h3>
  {errorMessage && <p class="field-error" role="alert">{errorMessage}</p>}

  <div class="honeypot-field" aria-hidden="true">
    <label for="contact-website">Leave this field blank</label>
    <input id="contact-website" type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field">
    <label for="contact-name">Name</label>
    <input id="contact-name" type="text" name="name" required class={errorField === 'name' ? 'field-missing' : ''} />
  </div>

  <div class="field">
    <label for="contact-business">Business and trade <span class="hint">Optional</span></label>
    <input id="contact-business" type="text" name="business_and_trade" />
  </div>

  <div class="field">
    <label id="contact-reach-label">{contact.form.reachLabel} <span class="hint">{contact.form.reachHint}</span></label>
    <input type="tel" name="telephone" placeholder="Telephone" aria-labelledby="contact-reach-label" style="margin-bottom:10px;" class={errorField === 'reach' ? 'field-missing' : ''} />
    <input type="text" name="address" placeholder="Address" aria-labelledby="contact-reach-label" style="margin-bottom:10px;" class={errorField === 'reach' ? 'field-missing' : ''} />
    <input type="email" name="email" placeholder="Email" aria-labelledby="contact-reach-label" class={errorField === 'reach' ? 'field-missing' : ''} />
  </div>

  <div class="field">
    <label for="contact-message">{contact.form.messageLabel}</label>
    <textarea id="contact-message" name="message" required class={errorField === 'message' ? 'field-missing' : ''}></textarea>
  </div>

  <button class="btn btn-primary" type="submit">{contact.form.submitLabel}</button>
</form>
