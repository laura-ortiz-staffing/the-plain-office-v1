---
import { secondLook } from '../../data/copy/second-look';

const errorField = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  name: 'We need your name.',
  mailing_address: 'We need your mailing address.',
  rate_limited: 'That is a lot of requests in a short time — please try again in a minute.',
};
const errorMessage = errorField ? errorMessages[errorField] : null;

function isMissing(field: string) {
  return errorField === field ? 'field-missing' : '';
}
---

<form class="tpo-form" method="post" action="/api/second-look" novalidate>
  {errorMessage && <p class="field-error" role="alert">{errorMessage}</p>}

  <div class="honeypot-field" aria-hidden="true">
    <label for="sl-website">Leave this field blank</label>
    <input id="sl-website" type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field-row">
    <div class="field">
      <label for="sl-name">Name</label>
      <input id="sl-name" type="text" name="name" class={isMissing('name')} />
    </div>
    <div class="field">
      <label for="sl-business">Business Name <span class="hint">Optional</span></label>
      <input id="sl-business" type="text" name="business_name" />
    </div>
  </div>

  <div class="field">
    <label for="sl-address">Mailing Address</label>
    <input id="sl-address" type="text" name="mailing_address" class={isMissing('mailing_address')} />
  </div>

  <div class="field-row">
    <div class="field">
      <label for="sl-phone">Phone Number <span class="hint">Optional</span></label>
      <input id="sl-phone" type="tel" name="telephone" />
    </div>
    <div class="field">
      <label for="sl-time">Best Time to Call</label>
      <select id="sl-time" name="best_time">
        {secondLook.form.bestTimeChoices.map((choice) => <option value={choice}>{choice}</option>)}
      </select>
    </div>
  </div>

  <div class="field">
    <label for="sl-books">Brief Description of Current Books <span class="hint">Optional</span></label>
    <textarea id="sl-books" name="books_kept_now" placeholder={secondLook.form.booksKeptPlaceholder}></textarea>
  </div>

  <button class="btn btn-primary" type="submit">{secondLook.form.submitLabel}</button>
</form>
