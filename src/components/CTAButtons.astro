---
import { site } from '../data/site';

interface Props {
  /** Show the "prefer paper" note underneath. Defaults to true. */
  showNote?: boolean;
}
const { showNote = true } = Astro.props;
---

<div class="btn-group">
  <a class="btn btn-primary" href={site.ctaBooklet.href}>{site.ctaBooklet.label}</a>
  <a class="btn btn-secondary" href={site.ctaSecondLook.href}>{site.ctaSecondLook.label}</a>
</div>
{showNote && <p class="small-note" style="margin-top: 14px;">{site.preferPaperNote}</p>}
