---
// Reused wherever the Copy Deck pairs a short title with one paragraph:
// service cards, the four "ways to run an office", and the "where the
// money leaks" items.
interface Props {
  title: string;
  body: string;
}
const { title, body } = Astro.props;
---

<div class="card">
  <h3>{title}</h3>
  <p style="margin:0; color:var(--color-ink-secondary);">{body}</p>
</div>
